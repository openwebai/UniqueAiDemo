# Obtain these from your customer success manager or platform admin
UNIQUE_API_KEY=ukey_your_api_key_here
UNIQUE_APP_ID=app_your_app_id_here

# These identify you / your org on the platform
UNIQUE_USER_ID=your_user_id_here
UNIQUE_COMPANY_ID=your_company_id_here

# For webhook signature verification (needed for event-driven apps)
UNIQUE_ENDPOINT_SECRET=your_endpoint_secret_here
